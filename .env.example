# Public site origin, no trailing slash. Used for canonical URLs, sitemap, and Open Graph.
# Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep "false" until placeholder copy, trips, and contact details are replaced.
# "true" allows indexing and lists the site in robots.txt.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Server-only. Where validated inquiries are POSTed as JSON.
# Required in production. Leave empty in local development to write .data/inquiries.ndjson instead.
INQUIRY_WEBHOOK_URL=

# Server-only. Sent as Authorization: Bearer <secret>. Required whenever INQUIRY_WEBHOOK_URL is set.
# Production webhook URLs must use https.
INQUIRY_WEBHOOK_SECRET=
